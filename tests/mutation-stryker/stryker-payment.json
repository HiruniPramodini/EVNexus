{
  "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker-net/master/src/Stryker.Core/Stryker.Core/stryker-config.schema.json",
  "stryker-config": {
    "project": "EVNexus.PaymentService.csproj",
    "test-projects": [
      "EVNexus.PaymentService.Tests.csproj"
    ],
    "reporters": [
      "progress",
      "cleartext",
      "html",
      "json"
    ],
    "mutation-level": "Standard",
    "coverage-analysis": "perTest",
    "thresholds": {
      "high": 80,
      "low": 65,
      "break": 65
    },
    "mutate": [
      "**/Forecasting/ForecastService.cs",
      "**/Kafka/OutboxPublisherService.cs",
      "**/Controllers/CompanyAnalyticsController.cs",
      "**/Controllers/WalletController.cs",
      "**/Controllers/PaymentsController.cs"
    ],
    "ignore-methods": [
      "*Log*",
      "LogInformation",
      "LogWarning",
      "LogError",
      "LogDebug",
      "LogTrace",
      "LogCritical",
      "ConfigureAwait"
    ],
    "concurrency": 4,
    "additional-timeout": 5000,
    "break-on-initial-test-failure": true
  }
}
