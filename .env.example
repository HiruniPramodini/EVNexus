# EVNexus Centralized Environment Template
# Copy this file to .env and fill in your actual local credentials.
# NEVER commit the real .env file to version control.

# Application Environment
ASPNETCORE_ENVIRONMENT=Development

# JWT Authentication
JWT_SECRET=CHANGE_ME

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM_EMAIL=CHANGE_ME
SMTP_FROM_NAME=EVNexus
SMTP_ENABLE_SSL=true

# Database Names
AUTH_DB_NAME=evnexus_auth
MAP_DB_NAME=evnexus_map
PAYMENT_DB_NAME=evnexus_payment
DASHBOARD_DB_NAME=evnexus_dashboard

# Database Credentials
MYSQL_USER=evnexus
MYSQL_ROOT_PASSWORD=CHANGE_ME
AUTH_DB_PASSWORD=CHANGE_ME
MAP_DB_PASSWORD=CHANGE_ME
PAYMENT_DB_PASSWORD=CHANGE_ME
DASHBOARD_DB_PASSWORD=CHANGE_ME

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=evnexus-kafka:9092
KAFKA_TOPIC_CHARGING_SESSION_COMPLETED=ChargingSessionCompleted

# Internal Service Security
INTERNAL_API_KEY=CHANGE_ME

# Frontend & Application URLs
FRONTEND_BASE_URL=http://localhost:3000
