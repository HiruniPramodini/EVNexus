# Vite development frontend. Playwright's managed server uses E2E_API_URL instead.
VITE_API_GATEWAY_URL=http://127.0.0.1:5000

# Copy to .env.test (ignored). Leave passwords blank until configuring local accounts.
PLAYWRIGHT_BASE_URL=http://127.0.0.1:3100
E2E_API_URL=http://127.0.0.1:15000
# Explicit acknowledgement: these URLs must serve dedicated test databases only.
E2E_ALLOW_MUTATIONS=
E2E_DRIVER_EMAIL=
E2E_DRIVER_PASSWORD=
E2E_COMPANY_EMAIL=
E2E_COMPANY_PASSWORD=
E2E_STATION_ID=
E2E_CHARGER_ID=
# Set to 1 only when you start and configure the frontend yourself.
PLAYWRIGHT_EXTERNAL_SERVER=0
