{
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth_cluster",
        "CorsPolicy": "AllowAll",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "company-route": {
        "ClusterId": "auth_cluster",
        "CorsPolicy": "AllowAll",
        "Match": {
          "Path": "/api/company/{**catch-all}"
        }
      },
      "driver-route": {
        "ClusterId": "auth_cluster",
        "CorsPolicy": "AllowAll",
        "Match": {
          "Path": "/api/driver/{**catch-all}"
        }
      },
      "admin-route": {
        "ClusterId": "auth_cluster",
        "CorsPolicy": "AllowAll",
        "Match": {
          "Path": "/api/admin/{**catch-all}"
        }
      },
      "map-company-sessions-route": {
        "ClusterId": "map_cluster",
        "CorsPolicy": "AllowAll",
        "Match": {
          "Path": "/api/company/sessions/{**catch-all}"
        }
      },
      "map-company-route": {
        "ClusterId": "map_cluster",
        "CorsPolicy": "AllowAll",
        "Match": {
          "Path": "/api/company/stations/{**catch-all}"
        }
      },
      "map-driver-route": {
        "ClusterId": "map_cluster",
        "CorsPolicy": "AllowAll",
        "Match": {
          "Path": "/api/driver/stations/{**catch-all}"
        }
      },
      "map-driver-sessions-route": {
        "ClusterId": "map_cluster",
        "CorsPolicy": "AllowAll",
        "Match": {
          "Path": "/api/driver/sessions/{**catch-all}"
        }
      },
      "map-route": {
        "ClusterId": "map_cluster",
        "CorsPolicy": "AllowAll",
        "Match": {
          "Path": "/api/map/{**catch-all}"
        }
      },
      "payment-route": {
        "ClusterId": "payment_cluster",
        "CorsPolicy": "AllowAll",
        "Match": {
          "Path": "/api/payment/{**catch-all}"
        }
      },
      "dashboard-route": {
        "ClusterId": "dashboard_cluster",
        "CorsPolicy": "AllowAll",
        "Match": {
          "Path": "/api/dashboard/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "auth_cluster": {
        "Destinations": {
          "auth_destination": {
            "Address": "http://authentication-service:8080/"
          }
        }
      },
      "map_cluster": {
        "Destinations": {
          "map_destination": {
            "Address": "http://map-service:8080/"
          }
        }
      },
      "payment_cluster": {
        "Destinations": {
          "payment_destination": {
            "Address": "http://payment-service:8080/"
          }
        }
      },
      "dashboard_cluster": {
        "Destinations": {
          "dashboard_destination": {
            "Address": "http://dashboard-service:8080/"
          }
        }
      }
    }
  }
}