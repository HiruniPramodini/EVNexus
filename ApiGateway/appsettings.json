{
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "company-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/company/{**catch-all}"
        }
      },
      "driver-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/driver/{**catch-all}"
        }
      },
      "admin-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/admin/{**catch-all}"
        }
      },
      "map-company-route": {
        "ClusterId": "map-cluster",
        "Match": {
          "Path": "/api/company/stations/{**catch-all}"
        }
      },
      "map-driver-route": {
        "ClusterId": "map-cluster",
        "Match": {
          "Path": "/api/driver/stations/{**catch-all}"
        }
      },
      "map-driver-sessions-route": {
        "ClusterId": "map-cluster",
        "Match": {
          "Path": "/api/driver/sessions/{**catch-all}"
        }
      },
      "map-route": {
        "ClusterId": "map-cluster",
        "Match": {
          "Path": "/api/map/{**catch-all}"
        }
      },
      "payment-route": {
        "ClusterId": "payment-cluster",
        "Match": {
          "Path": "/api/payment/{**catch-all}"
        }
      },
      "dashboard-route": {
        "ClusterId": "dashboard-cluster",
        "Match": {
          "Path": "/api/dashboard/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "auth-destination": {
            "Address": "http://authentication-service:8080/"
          }
        }
      },
      "map-cluster": {
        "Destinations": {
          "map-destination": {
            "Address": "http://map-service:8080/"
          }
        }
      },
      "payment-cluster": {
        "Destinations": {
          "payment-destination": {
            "Address": "http://payment-service:8080/"
          }
        }
      },
      "dashboard-cluster": {
        "Destinations": {
          "dashboard-destination": {
            "Address": "http://dashboard-service:8080/"
          }
        }
      }
    }
  }
}