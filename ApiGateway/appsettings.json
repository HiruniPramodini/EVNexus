{
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "map-route": {
        "ClusterId": "map-cluster",
        "Match": {
          "Path": "/api/map/{**catch-all}"
        }
      },
      "payment-route": {
        "ClusterId": "payment-cluster",
        "Match": {
          "Path": "/api/payment/{**catch-all}"
        }
      },
      "dashboard-route": {
        "ClusterId": "dashboard-cluster",
        "Match": {
          "Path": "/api/dashboard/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "auth-destination": {
            "Address": "http://localhost:5138/"
          }
        }
      },
      "map-cluster": {
        "Destinations": {
          "map-destination": {
            "Address": "http://localhost:5001/"
          }
        }
      },
      "payment-cluster": {
        "Destinations": {
          "payment-destination": {
            "Address": "http://localhost:5002/"
          }
        }
      },
      "dashboard-cluster": {
        "Destinations": {
          "dashboard-destination": {
            "Address": "http://localhost:5003/"
          }
        }
      }
    }
  }
}